# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project Settings → API). For local dev: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used by payment verification, seed scripts and maintenance. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the site (auth email links, payment return/callback URLs, social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: off | test | live
#   test = simulated payments and top-ups, recorded as "test" (never "paid")
#   live = Paystack; falls back to off unless PAYSTACK_SECRET_KEY is set
PAYMENTS_MODE=off

# Paystack (Dashboard → Settings → API Keys & Webhooks). Use sk_test_… first, then sk_live_….
# Webhook URL to paste into Paystack: https://<your-domain>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# PAYSTACK_CURRENCY=GHS

# Airtime and data DELIVERY. Paystack collects the money; a top-up API sends the credit.
# Without these, the Airtime page stays switched off in live mode.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_CALLBACK_TOKEN=
# HUBTEL_TOPUP_URL=https://cs.hubtel.com/commissionservices/{deposit}/{service}

# Airtime and data (Hubtel commission services; IDs from your Hubtel dashboard)
HUBTEL_PREPAID_DEPOSIT_ID=
HUBTEL_SERVICE_MTN_AIRTIME=
HUBTEL_SERVICE_MTN_DATA=
HUBTEL_SERVICE_TELECEL_AIRTIME=
HUBTEL_SERVICE_TELECEL_DATA=
HUBTEL_SERVICE_AIRTELTIGO_AIRTIME=
HUBTEL_SERVICE_AIRTELTIGO_DATA=

# Crypto payments (NOWPayments). Off unless CRYPTO_PAYMENTS=on and both keys are set.
# Confirm with the Bank of Ghana / a lawyer whether accepting crypto requires registration under the VASP Act 2025 first.
# Also set the GH₵/US$ rate in Admin → Settings ("crypto_usd_rate"); 0 hides crypto.
CRYPTO_PAYMENTS=off
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Sandbox: https://api-sandbox.nowpayments.io/v1
# NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# Protects /api/cron (expiry of listings, promotions and unpaid orders)
CRON_SECRET=
