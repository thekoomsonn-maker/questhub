# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project Settings → API). For local dev: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used by seed scripts, payment webhooks and maintenance jobs. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the site (used in auth email links and social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments stay off until a provider is configured and tested.
CHECKOUT_ENABLED=false
PAYSTACK_SECRET_KEY=
